{
  "components": {
    "schemas": {
      "CompletionRequest": {
        "description": "Optional completion body. Omit it (or `date`) to complete for today.",
        "properties": {
          "date": {
            "description": "Completion date in the app zone; not in the future",
            "example": "2026-09-25",
            "format": "date",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CompletionResponse": {
        "description": "One habit completion",
        "properties": {
          "createdAt": {
            "example": "2026-09-26T15:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "date": {
            "example": "2026-09-26",
            "format": "date",
            "type": "string"
          },
          "habitId": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "example": 10,
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "HabitRequest": {
        "description": "Create or update a habit",
        "properties": {
          "description": {
            "example": "Before bed",
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "frequency": {
            "enum": [
              "DAILY",
              "WEEKLY"
            ],
            "example": "DAILY",
            "type": "string"
          },
          "name": {
            "example": "Read 20 pages",
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "frequency",
          "name"
        ],
        "type": "object"
      },
      "HabitResponse": {
        "description": "A habit with its computed progress fields",
        "properties": {
          "active": {
            "example": true,
            "type": "boolean"
          },
          "createdAt": {
            "example": "2026-09-26T15:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "currentStreak": {
            "description": "Consecutive days (daily) or ISO weeks (weekly) completed, ending now or in the previous period",
            "example": 3,
            "format": "int32",
            "type": "integer"
          },
          "description": {
            "example": "Before bed",
            "type": "string"
          },
          "doneThisPeriod": {
            "description": "Daily: done today. Weekly: at least one completion in the current ISO week",
            "example": true,
            "type": "boolean"
          },
          "doneToday": {
            "description": "A completion exists for today (any frequency)",
            "example": true,
            "type": "boolean"
          },
          "frequency": {
            "enum": [
              "DAILY",
              "WEEKLY"
            ],
            "example": "DAILY",
            "type": "string"
          },
          "id": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "lastCompletedDate": {
            "example": "2026-09-26",
            "format": "date",
            "type": "string"
          },
          "name": {
            "example": "Read 20 pages",
            "type": "string"
          },
          "progressPercent": {
            "description": "Daily: completed days in the last 7 ÷ 7. Weekly: completed weeks in the last 4 ÷ 4. 0–100",
            "example": 43,
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Single-user productivity API: tasks, habits, learning resources, todo plans, dashboard, settings.",
    "title": "QuickFlow API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/habits": {
      "get": {
        "description": "All habits by id; filter with `active`.",
        "operationId": "list",
        "parameters": [
          {
            "description": "true = active only, false = deactivated only, omitted = all",
            "in": "query",
            "name": "active",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HabitResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List habits",
        "tags": [
          "Habits"
        ]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}": {
      "delete": {
        "description": "Hard delete; its completions are deleted too (D-25).",
        "operationId": "delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Habit not found"
          }
        },
        "summary": "Delete a habit",
        "tags": [
          "Habits"
        ]
      },
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Habit not found"
          }
        },
        "summary": "Get a habit",
        "tags": [
          "Habits"
        ]
      },
      "put": {
        "operationId": "update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Habit not found"
          }
        },
        "summary": "Update a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/activate": {
      "post": {
        "operationId": "activate",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Activate a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/completions": {
      "get": {
        "description": "Newest first.",
        "operationId": "completions",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CompletionResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Habit not found"
          }
        },
        "summary": "List a habit's completions",
        "tags": [
          "Habits"
        ]
      },
      "post": {
        "description": "For today, or for `date` (not in the future).",
        "operationId": "complete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Completion recorded"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Date in the future"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Habit not found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Already completed on that date"
          }
        },
        "summary": "Complete a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/completions/today": {
      "delete": {
        "operationId": "uncompleteToday",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "Habit not found, or not completed today"
          }
        },
        "summary": "Un-complete a habit for today",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/completions/{date}": {
      "delete": {
        "operationId": "uncomplete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "Habit not found, or not completed on that date"
          }
        },
        "summary": "Remove a completion on a date",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/deactivate": {
      "post": {
        "description": "Hidden from today's lists but kept.",
        "operationId": "deactivate",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Deactivate a habit",
        "tags": [
          "Habits"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Generated server url",
      "url": "http://localhost:8081"
    }
  ],
  "tags": [
    {
      "description": "Recurring habits and their completions (FR-03, FR-04)",
      "name": "Habits"
    }
  ]
}
