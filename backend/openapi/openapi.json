{
  "components": {
    "schemas": {
      "CompletionRequest": {
        "description": "Optional completion body. Omit it (or `date`) to complete for today.",
        "properties": {
          "date": {
            "description": "Completion date in the app zone; not in the future",
            "example": "2026-09-25",
            "format": "date",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CompletionResponse": {
        "description": "One habit completion",
        "properties": {
          "createdAt": {
            "example": "2026-09-26T15:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "date": {
            "example": "2026-09-26",
            "format": "date",
            "type": "string"
          },
          "habitId": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "example": 10,
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "HabitRequest": {
        "description": "Create or update a habit",
        "properties": {
          "description": {
            "example": "Before bed",
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "frequency": {
            "enum": [
              "DAILY",
              "WEEKLY"
            ],
            "example": "DAILY",
            "type": "string"
          },
          "name": {
            "example": "Read 20 pages",
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "frequency",
          "name"
        ],
        "type": "object"
      },
      "HabitResponse": {
        "description": "A habit with its computed progress fields",
        "properties": {
          "active": {
            "example": true,
            "type": "boolean"
          },
          "createdAt": {
            "example": "2026-09-26T15:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "currentStreak": {
            "description": "Consecutive days (daily) or ISO weeks (weekly) completed, ending now or in the previous period",
            "example": 3,
            "format": "int32",
            "type": "integer"
          },
          "description": {
            "example": "Before bed",
            "type": "string"
          },
          "doneThisPeriod": {
            "description": "Daily: done today. Weekly: at least one completion in the current ISO week",
            "example": true,
            "type": "boolean"
          },
          "doneToday": {
            "description": "A completion exists for today (any frequency)",
            "example": true,
            "type": "boolean"
          },
          "frequency": {
            "enum": [
              "DAILY",
              "WEEKLY"
            ],
            "example": "DAILY",
            "type": "string"
          },
          "id": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "lastCompletedDate": {
            "example": "2026-09-26",
            "format": "date",
            "type": "string"
          },
          "name": {
            "example": "Read 20 pages",
            "type": "string"
          },
          "progressPercent": {
            "description": "Daily: completed days in the last 7 ÷ 7. Weekly: completed weeks in the last 4 ÷ 4. 0–100",
            "example": 43,
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TaskRequest": {
        "description": "Create or update a task",
        "properties": {
          "description": {
            "example": "Quarterly numbers",
            "maxLength": 2000,
            "minLength": 0,
            "type": "string"
          },
          "dueDate": {
            "description": "Optional due date. On update, omitted/null clears it",
            "example": "2026-09-30",
            "format": "date",
            "type": "string"
          },
          "priority": {
            "description": "Create: defaults to MEDIUM. Update: omitted keeps the current priority",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "example": "HIGH",
            "type": "string"
          },
          "status": {
            "description": "Create: defaults to TODO. Update: omitted keeps the current status",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "DONE"
            ],
            "example": "TODO",
            "type": "string"
          },
          "title": {
            "example": "Write the report",
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "TaskResponse": {
        "description": "A task with its computed overdue flag",
        "properties": {
          "archived": {
            "example": false,
            "type": "boolean"
          },
          "completedAt": {
            "description": "Set while status is DONE",
            "example": "2026-09-26T16:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "example": "2026-09-26T15:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "example": "Quarterly numbers",
            "type": "string"
          },
          "dueDate": {
            "example": "2026-09-30",
            "format": "date",
            "type": "string"
          },
          "id": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "overdue": {
            "description": "dueDate is before today, status is not DONE, and the task is not archived",
            "example": false,
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "example": "HIGH",
            "type": "string"
          },
          "status": {
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "DONE"
            ],
            "example": "TODO",
            "type": "string"
          },
          "title": {
            "example": "Write the report",
            "type": "string"
          },
          "updatedAt": {
            "example": "2026-09-26T15:00:00Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Single-user productivity API: tasks, habits, learning resources, todo plans, dashboard, settings.",
    "title": "QuickFlow API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/habits": {
      "get": {
        "description": "All habits by id; filter with `active`.",
        "operationId": "list_1",
        "parameters": [
          {
            "description": "true = active only, false = deactivated only, omitted = all",
            "in": "query",
            "name": "active",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HabitResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List habits",
        "tags": [
          "Habits"
        ]
      },
      "post": {
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}": {
      "delete": {
        "description": "Hard delete; its completions are deleted too (D-25).",
        "operationId": "delete_1",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Habit not found"
          }
        },
        "summary": "Delete a habit",
        "tags": [
          "Habits"
        ]
      },
      "get": {
        "operationId": "get_1",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Habit not found"
          }
        },
        "summary": "Get a habit",
        "tags": [
          "Habits"
        ]
      },
      "put": {
        "operationId": "update_1",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "Habit not found"
          }
        },
        "summary": "Update a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/activate": {
      "post": {
        "operationId": "activate",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Activate a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/completions": {
      "get": {
        "description": "Newest first.",
        "operationId": "completions",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CompletionResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Habit not found"
          }
        },
        "summary": "List a habit's completions",
        "tags": [
          "Habits"
        ]
      },
      "post": {
        "description": "For today, or for `date` (not in the future).",
        "operationId": "complete_1",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Completion recorded"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Date in the future"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Habit not found"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            },
            "description": "Already completed on that date"
          }
        },
        "summary": "Complete a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/completions/today": {
      "delete": {
        "operationId": "uncompleteToday",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "Habit not found, or not completed today"
          }
        },
        "summary": "Un-complete a habit for today",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/completions/{date}": {
      "delete": {
        "operationId": "uncomplete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "Habit not found, or not completed on that date"
          }
        },
        "summary": "Remove a completion on a date",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/habits/{id}/deactivate": {
      "post": {
        "description": "Hidden from today's lists but kept.",
        "operationId": "deactivate",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Deactivate a habit",
        "tags": [
          "Habits"
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "description": "Filters combine with AND. Archived tasks are excluded unless `archived=true` (which lists only archived ones). Sort by `createdAt` (default, newest first) or `dueDate` (default ascending); tasks without a due date always sort last.",
        "operationId": "list",
        "parameters": [
          {
            "description": "Case-insensitive substring of the title",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "TODO",
                "IN_PROGRESS",
                "DONE"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ],
              "type": "string"
            }
          },
          {
            "description": "Exact due date",
            "in": "query",
            "name": "dueDate",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Due on or after this date",
            "in": "query",
            "name": "dueFrom",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Due on or before this date",
            "in": "query",
            "name": "dueTo",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "false (default) = active tasks, true = archived tasks only",
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "createdAt",
                "dueDate"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "dir",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Invalid filter, sort or dir"
          }
        },
        "summary": "List and search tasks",
        "tags": [
          "Tasks"
        ]
      },
      "post": {
        "description": "Status defaults to TODO, priority to MEDIUM.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create a task",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/api/v1/tasks/{id}": {
      "delete": {
        "description": "Hard delete (BR-14).",
        "operationId": "delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Task not found"
          }
        },
        "summary": "Delete a task",
        "tags": [
          "Tasks"
        ]
      },
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Task not found"
          }
        },
        "summary": "Get a task",
        "tags": [
          "Tasks"
        ]
      },
      "put": {
        "description": "Setting status to DONE sets `completedAt`; leaving DONE clears it.",
        "operationId": "update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Task not found"
          }
        },
        "summary": "Update a task",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/api/v1/tasks/{id}/archive": {
      "post": {
        "description": "Hidden from the default list; see `archived=true`.",
        "operationId": "archive",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
