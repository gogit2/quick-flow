          }
        },
        "summary": "Archive a task",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/api/v1/tasks/{id}/complete": {
      "post": {
        "description": "Sets status DONE and `completedAt`.",
        "operationId": "complete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Task not found"
          }
        },
        "summary": "Complete a task",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/api/v1/tasks/{id}/restore": {
      "post": {
        "operationId": "restore",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Task not found"
          }
        },
        "summary": "Restore an archived task",
        "tags": [
          "Tasks"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Generated server url",
      "url": "http://localhost:8081"
    }
  ],
  "tags": [
    {
      "description": "Tasks: CRUD, complete, archive/restore, search and filters (FR-01, FR-02)",
      "name": "Tasks"
